APP_NAME=ServerWatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitor.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/serverwatch/database.sqlite
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MONITOR_OFFLINE_AFTER_SECONDS=180
MONITOR_NOTIFICATION_WEBHOOK_URL=
