APP_NAME=ServerWatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitor.example.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=false
MONITOR_OFFLINE_AFTER_SECONDS=180
MONITOR_OFFLINE_CHECK_SECONDS=60
MONITOR_NOTIFICATION_WEBHOOK_URL=
